{
  "name": "collie-writer-site",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "format": "prettier --write \"src/**/*.{ts,tsx,css,md}\" \"build-support/**/*.ts\" \"*.{js,cjs,ts,json,html,md}\" .prettierrc.json",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.node.json",
    "preview": "vite preview"
  },
  "dependencies": {
    "@mantine/carousel": "^9.7.2",
    "@mantine/charts": "^9.7.2",
    "@mantine/code-highlight": "^9.7.2",
    "@mantine/core": "^9.7.2",
    "@mantine/dates": "^9.7.2",
    "@mantine/dropzone": "^9.7.2",
    "@mantine/form": "^9.7.2",
    "@mantine/hooks": "^9.7.2",
    "@mantine/lightbox": "^9.7.2",
    "@mantine/modals": "^9.7.2",
    "@mantine/notifications": "^9.7.2",
    "@mantine/nprogress": "^9.7.2",
    "@mantine/spotlight": "^9.7.2",
    "@mantine/tiptap": "^9.7.2",
    "@tiptap/extension-link": "^3.32.0",
    "@tiptap/pm": "^3.32.0",
    "@tiptap/react": "^3.32.0",
    "@tiptap/starter-kit": "^3.32.0",
    "dayjs": "^1.11.23",
    "embla-carousel": "^8.6.0",
    "embla-carousel-react": "^8.6.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "8.4.0",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@resvg/resvg-js": "2.6.2",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "postcss": "^8.5.30",
    "postcss-preset-mantine": "^1.18.0",
    "postcss-simple-vars": "^7.0.1",
    "prettier": "3.7.4",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.3.0"
  }
